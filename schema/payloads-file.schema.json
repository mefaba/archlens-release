{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "request",
              "response",
              "event",
              "record",
              "other"
            ]
          },
          "contentType": {
            "type": "string",
            "maxLength": 120
          },
          "method": {
            "type": "string",
            "maxLength": 16
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "headers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "body": {
            "$ref": "#/$defs/__schema0"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "illustrative": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "verified",
                  "documented",
                  "observed",
                  "inferred",
                  "unknown"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "string",
                    "enum": [
                      "verified",
                      "documented",
                      "observed",
                      "inferred",
                      "unknown"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 600
                  }
                },
                "required": [
                  "level"
                ],
                "additionalProperties": false
              }
            ]
          },
          "sources": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "payloads"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
