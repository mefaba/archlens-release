{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "communication",
              "dependency",
              "invocation",
              "data-exchange",
              "containment",
              "event"
            ]
          },
          "from": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "to": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 8000
          },
          "protocol": {
            "type": "string",
            "maxLength": 60
          },
          "operation": {
            "type": "string",
            "maxLength": 200
          },
          "direction": {
            "type": "string",
            "enum": [
              "forward",
              "bidirectional"
            ]
          },
          "detail": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "payload": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "verified",
                  "documented",
                  "observed",
                  "inferred",
                  "unknown"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "string",
                    "enum": [
                      "verified",
                      "documented",
                      "observed",
                      "inferred",
                      "unknown"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 600
                  }
                },
                "required": [
                  "level"
                ],
                "additionalProperties": false
              }
            ]
          },
          "sources": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "relationships"
  ],
  "additionalProperties": false
}
