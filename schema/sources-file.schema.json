{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "code",
              "commit",
              "symbol",
              "doc",
              "api-spec",
              "trace",
              "url"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "repository": {
            "type": "string",
            "maxLength": 500
          },
          "path": {
            "type": "string",
            "maxLength": 1000
          },
          "lineStart": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "lineEnd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "commit": {
            "type": "string",
            "maxLength": 80
          },
          "symbol": {
            "type": "string",
            "maxLength": 500
          },
          "section": {
            "type": "string",
            "maxLength": 500
          },
          "traceId": {
            "type": "string",
            "maxLength": 200
          },
          "spanId": {
            "type": "string",
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https?:\\/\\/[^\\s]+$"
          },
          "note": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sources"
  ],
  "additionalProperties": false
}
