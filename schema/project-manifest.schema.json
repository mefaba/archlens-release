{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "archlens-project"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 8000
    },
    "metadata": {
      "type": "object",
      "properties": {
        "authors": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "tags": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 60
          }
        },
        "topic": {
          "type": "string",
          "maxLength": 200
        },
        "license": {
          "type": "string",
          "maxLength": 120
        },
        "illustrative": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 8000
        },
        "attributes": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "verified",
                "documented",
                "observed",
                "inferred",
                "unknown"
              ]
            },
            {
              "type": "object",
              "properties": {
                "level": {
                  "type": "string",
                  "enum": [
                    "verified",
                    "documented",
                    "observed",
                    "inferred",
                    "unknown"
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 600
                }
              },
              "required": [
                "level"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "minVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "requires": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "optional": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "entities": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|\\/)\\.\\.?(\\/|$))[^\\0]+$"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|\\/)\\.\\.?(\\/|$))[^\\0]+$"
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|\\/)\\.\\.?(\\/|$))[^\\0]+$"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|\\/)\\.\\.?(\\/|$))[^\\0]+$"
          }
        },
        "payloads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|\\/)\\.\\.?(\\/|$))[^\\0]+$"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|\\/)\\.\\.?(\\/|$))[^\\0]+$"
          }
        },
        "presentation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|\\/)\\.\\.?(\\/|$))[^\\0]+$"
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|\\/)\\.\\.?(\\/|$))[^\\0]+$"
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|\\/)\\.\\.?(\\/|$))[^\\0]+$"
          }
        }
      },
      "required": [
        "entities"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "formatVersion",
    "schemaVersion",
    "id",
    "version",
    "title",
    "files"
  ],
  "additionalProperties": false
}
